{
  "name": "stockonchain-monorepo",
  "version": "0.1.0",
  "private": true,
  "description": "StockOnChain: Stokvel-pot tokenization and savings on Stellar Soroban",
  "scripts": {
    "dev": "pnpm --filter web dev",
    "build": "pnpm --filter \"./apps/**\" --filter \"./packages/**\" --filter \"./services/**\" build",
    "start": "pnpm --filter web start",
    "lint": "pnpm -r lint",
    "format": "prettier --write \"apps/web/**/*.{ts,tsx,css,js,json,webmanifest,html}\"",
    "format:check": "prettier --check \"apps/web/**/*.{ts,tsx,css,js,json,webmanifest,html}\"",
    "test": "tsx --test scripts/network-guard.test.ts scripts/zatbill.test.ts scripts/mzar.test.ts services/api/src/faucet.test.ts services/api/src/kyc.test.ts apps/web/app/lib/currency.test.ts apps/web/app/.well-known/stellar.toml/route.test.ts packages/chain/src/dealer.test.ts packages/chain/src/attestation.test.ts apps/web/app/api/backing/route.test.ts",
    "chain:bootstrap": "tsx scripts/bootstrap.ts",
    "chain:zatbill": "tsx scripts/zatbill.ts",
    "chain:mzar": "tsx scripts/mzar.ts",
    "chain:attestation:anchor": "tsx scripts/anchor-attestation.ts",
    "chain:attestation:verify": "tsx scripts/verify-backing.ts",
    "chain:attestation:post": "tsx scripts/post-attestation.ts",
    "demo:invest": "tsx scripts/demo-invest.ts",
    "demo:mature": "tsx scripts/demo-mature.ts",
    "quickstart": "node scripts/quickstart.mjs",
    "contract:build": "stellar contract build",
    "contract:test": "cargo test"
  },
  "packageManager": "pnpm@9.15.9",
  "devDependencies": {
    "@stellar/stellar-sdk": "12.3.0",
    "@types/node": "20.19.43",
    "dotenv": "16.6.1",
    "eslint": "^8.57.1",
    "eslint-config-next": "^14.2.0",
    "prettier": "^3.10.1",
    "tsx": "4.23.15",
    "typescript": "^5.7.0"
  }
}
