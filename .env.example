# ==============================================================================
# StockOnChain Environment Configuration Template
# ------------------------------------------------------------------------------
# INSTRUCTIONS:
# 1. Copy this file to '.env' (which is git-ignored):
#      cp .env.example .env
# 2. Set any required secrets only in your local '.env'.
# 3. DO NOT commit '.env' or share secrets with an AI tool.
# ==============================================================================

# Testnet only. Bootstrap refuses any other network or passphrase.
STELLAR_NETWORK=testnet

# Stellar Soroban RPC Endpoint
STELLAR_RPC_URL=https://soroban-testnet.stellar.org

# Stellar Network Passphrase
STELLAR_NETWORK_PASSPHRASE="Test SDF Network ; September 2015"

# Role keypairs are generated by `pnpm chain:bootstrap` and stored only in this
# ignored local file. Never copy secret keys into source control or an AI tool.
STELLAR_ADMIN_PUBLIC_KEY=
STELLAR_ADMIN_SECRET_KEY=

STELLAR_ISSUER_PUBLIC_KEY=
STELLAR_ISSUER_SECRET_KEY=
STELLAR_DEALER_PUBLIC_KEY=
STELLAR_DEALER_SECRET_KEY=
STELLAR_CUSTODIAN_PUBLIC_KEY=
STELLAR_CUSTODIAN_SECRET_KEY=
STELLAR_SPONSOR_PUBLIC_KEY=
STELLAR_SPONSOR_SECRET_KEY=
STELLAR_ANCHOR_SIM_PUBLIC_KEY=
STELLAR_ANCHOR_SIM_SECRET_KEY=

# Dedicated ZATBILL issuer. Set the public HTTPS host (domain only, no scheme)
# before running `pnpm chain:zatbill setup` so it can publish SEP-1 metadata.
STELLAR_ZATBILL_ISSUER_PUBLIC_KEY=
STELLAR_ZATBILL_ISSUER_SECRET_KEY=
STELLAR_HOME_DOMAIN=

STELLAR_CONTRACT_ID=
